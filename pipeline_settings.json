{
  "ocr": {
    "mode": "api",
    "auto_fallback": true,
    "local_engine": "pure_ocr",
    "api_provider": "capcut",
    "api_fusion_mode": "hybrid_ocr",
    "capcut_api_endpoint": "https://editor-api-sg.capcutapi.com",
    "capcut_session_token": "",
    "capcut_mode": "cloud_api",
    "capcut_draft_id": "",
    "method": "ocr",
    "engine": "rapidocr",
    "primary_backend": "rapidocr",
    "fallback_backend": "rapidocr",
    "ppocr_model_tier": "mobile",
    "enable_nvdec_hwaccel": false,
    "nvdec_device_id": 0,
    "enable_anti_noise_funnel": false,
    "anti_noise_ar_min": 0.88,
    "anti_noise_h_max": 130,
    "anti_noise_swt_cov_max": 0.4,
    "anti_noise_lum_min": 135,
    "enable_stroke_dhash_cache": false,
    "stroke_dhash_threshold": 4,
    "dbnet_limit_side_len": 960,
    "dbnet_limit_type": "max",
    "hardware_tuning_mode": "auto",
    "recognition_batch_size": 6,
    "default_source_lang": "auto",
    "sample_fps": 2.5,
    "diff_threshold": 2.5,
    "enable_gap_rescue": true,
    "gap_rescue_max_frames": 20,
    "enable_roi_tightening": true,
    "enable_early_exit": true,
    "performance_profile": "full_speed_quality",
    "include_advanced_preprocessing": false,
    "edge_gating_threshold": 0.0,
    "vlm_provider": "gemini",
    "vlm_prompt_style": "accurate_dialogue",
    "demux_fallback_to_ocr": true,
    "demux_stream_lang": "auto"
  },
  "translation": {
    "provider": "gemini",
    "target_language": "vi",
    "gemini_model": "gemini-3.8-flash",
    "local_model": "qwen2.5:7b-instruct",
    "local_endpoint": "http://localhost:11434",
    "auto_fallback": true,
    "batch_size": 35,
    "prompt_tone": "dramatic",
    "use_glossary": true
  },
  "dubbing": {
    "enabled": true,
    "provider": "capcut",
    "mode": "multi",
    "voice": "vi-VN-NamMinhNeural",
    "voice_male": "vi-VN-NamMinhNeural",
    "voice_female": "vi_female_huong",
    "auto_detect_speakers": true,
    "gemini_prompt_style": "dramatic",
    "rate": "+10%",
    "pitch": "+0Hz",
    "ducking_volume": 0.25
  },
  "render": {
    "ffmpeg_encoder": "auto",
    "default_mask_style": "feather_tight",
    "default_blur_strength": 24,
    "burn_subtitles": true
  },
  "batch": {
    "target_lang": "vi",
    "ducking_volume": 25,
    "dubbing_enabled": true,
    "dubbing_mode": "gender_multi",
    "dubbing_voice": "vi-VN-NamMinhNeural",
    "export_format": "mp4",
    "export_resolution": "original",
    "export_aspect_ratio": "original",
    "stage_ocr": true,
    "stage_translate": true,
    "stage_dubbing": true,
    "stage_export": true,
    "active_preset_id": "",
    "sort_mode": "status",
    "grid_cols": 3
  }
}
