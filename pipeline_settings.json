{
  "ocr": {
    "mode": "api",
    "local_engine": "hybrid",
    "api_provider": "capcut",
    "capcut_api_endpoint": "https://editor-api-sg.capcutapi.com",
    "capcut_session_token": "",
    "capcut_mode": "cloud_api",
    "capcut_draft_id": "",
    "groq_api_key": "",
    "groq_model": "whisper-large-v3",
    "method": "asr_whisper",
    "engine": "rapidocr",
    "default_source_lang": "auto",
    "sample_fps": 2.5,
    "diff_threshold": 2.5,
    "enable_gap_rescue": true,
    "enable_roi_tightening": true,
    "whisper_model": "small",
    "whisper_device": "cuda",
    "whisper_compute_type": "float16",
    "whisper_vad_filter": true,
    "vlm_provider": "gemini",
    "vlm_prompt_style": "accurate_dialogue",
    "demux_fallback_to_ocr": true,
    "demux_stream_lang": "auto",
    "hybrid_whisper_model": "small",
    "hybrid_confidence_threshold": 0.65,
    "hybrid_rescue_missing": true,
    "auto_fallback": true
  },
  "translation": {
    "provider": "gemini",
    "target_language": "vi",
    "gemini_model": "gemini-3.8-flash",
    "local_model": "qwen2.5:7b-instruct",
    "local_endpoint": "http://localhost:11434",
    "auto_fallback": true,
    "batch_size": 35,
    "prompt_tone": "dramatic",
    "use_glossary": true
  },
  "dubbing": {
    "mode": "single",
    "voice": "vi-VN-NamMinhNeural",
    "voice_male": "vi-VN-NamMinhNeural",
    "voice_female": "vi-VN-HoaiMyNeural",
    "auto_detect_speakers": true,
    "rate": "+0%",
    "pitch": "+0Hz",
    "ducking_volume": 0.25
  },
  "render": {
    "ffmpeg_encoder": "auto",
    "default_mask_style": "feather_tight",
    "default_blur_strength": 24,
    "burn_subtitles": true
  }
}