{
  "schema_version": "benchmark-input-v1",
  "required": [
    "detector",
    "ocr",
    "translation",
    "timing",
    "memory",
    "disk",
    "utf8_gate"
  ],
  "detector": {
    "required": ["candidate", "version"]
  },
  "ocr": {
    "required": ["candidate", "model"]
  },
  "translation": {
    "required": ["candidate", "runtime"]
  },
  "timing": {
    "required": ["pts_required", "median_error_ms", "p95_error_ms"]
  },
  "memory": {
    "required": ["peak_ram_bytes", "peak_vram_bytes"]
  },
  "disk": {
    "required": ["cache_bytes", "output_bytes"]
  },
  "utf8_gate": {
    "required": ["reject_replacement_character", "reject_mojibake"]
  }
}
